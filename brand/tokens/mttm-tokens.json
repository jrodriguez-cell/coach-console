{
  "brand": {
    "name": "Make Time To Move",
    "short": "MTTM",
    "handle": "@maketimetomove",
    "file_prefix": "mttm-"
  },
  "color": {
    "sage": {
      "value": "#B7C0AE",
      "role": "Master ground (app canvas, stories, profile)"
    },
    "ink": {
      "value": "#0E0E0D",
      "role": "Master lettering, marks and text"
    },
    "fern": {
      "value": "#4F5549",
      "role": "Secondary text and small labels on Sage (app muted)"
    },
    "fern-light": {
      "value": "#5F665A",
      "role": "Secondary marks on Sage: chart guides, planned values"
    },
    "bone": {
      "value": "#EFEBE3",
      "role": "Paper ground; light lettering on Ink"
    },
    "stone": {
      "value": "#8F8B83",
      "role": "Secondary text on Ink"
    },
    "moss": {
      "value": "#1E2A23",
      "role": "Interviews ground"
    },
    "chalk": {
      "value": "#E8E6DD",
      "role": "Light on Moss"
    },
    "lichen": {
      "value": "#8C948D",
      "role": "Secondary text on Moss"
    },
    "midnight": {
      "value": "#121A26",
      "role": "Mindset ground"
    },
    "mist": {
      "value": "#E3E7EC",
      "role": "Light on Midnight"
    },
    "slate": {
      "value": "#87909C",
      "role": "Secondary text on Midnight"
    },
    "black": {
      "value": "#000000",
      "role": "Utility: one-colour reproduction"
    },
    "white": {
      "value": "#FFFFFF",
      "role": "Utility: one-colour reproduction"
    }
  },
  "theme": {
    "start-here": {
      "pillar": "Start Here",
      "foreground": "#0E0E0D",
      "background": "#B7C0AE",
      "muted": "#4F5549"
    },
    "strength": {
      "pillar": "Strength",
      "foreground": "#B7C0AE",
      "background": "#0E0E0D",
      "muted": "#8F8B83"
    },
    "mobility": {
      "pillar": "Mobility",
      "foreground": "#0E0E0D",
      "background": "#EFEBE3",
      "muted": "#4F5549"
    },
    "mindset": {
      "pillar": "Mindset",
      "foreground": "#E3E7EC",
      "background": "#121A26",
      "muted": "#87909C"
    },
    "interviews": {
      "pillar": "Interviews",
      "foreground": "#E8E6DD",
      "background": "#1E2A23",
      "muted": "#8C948D"
    }
  },
  "font": {
    "display": {
      "family": "MTTM Lettering",
      "fallback": "sans-serif (generic keyword only; never substitute another typeface)",
      "case": "uppercase",
      "letterSpacing": "0 (brand spacing is built into the font)",
      "weights": {
        "Regular": 400,
        "Heavy": 800
      },
      "files": [
        "fonts/mttm-lettering-regular.woff2",
        "fonts/mttm-lettering-heavy.woff2"
      ]
    },
    "body": {
      "family": "Manrope",
      "fallback": "system-ui, sans-serif",
      "weights": [
        400,
        500,
        600
      ],
      "source": "https://fonts.google.com/specimen/Manrope"
    }
  },
  "space": {
    "unit": "8px",
    "scale": [
      4,
      8,
      16,
      24,
      32,
      48,
      64,
      96,
      128
    ]
  },
  "tint": {
    "hairline": "fg at 20%",
    "rule-strong": "fg at 40%",
    "fill": "fg at 5%",
    "button-border": "fg at 35%"
  },
  "type": {
    "label": "Manrope 500, 11px, uppercase, letter-spacing 0.12em, muted",
    "title": "Manrope 600, 24-28px, tight",
    "display": "MTTM Lettering, capitals, letter-spacing 0"
  },
  "radius": {
    "none": "0",
    "subtle": "2px"
  },
  "rule": {
    "hairline": "1px"
  }
}
